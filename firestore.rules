rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function rolePath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/user_roles/$(request.auth.token.email);
    }

    function hasActiveRole(appId) {
      return signedIn()
        && exists(rolePath(appId))
        && get(rolePath(appId)).data.active != false
        && get(rolePath(appId)).data.uid == request.auth.uid;
    }

    function hasRole(appId, expectedRole) {
      return hasActiveRole(appId)
        && get(rolePath(appId)).data.role == expectedRole;
    }

    function isAdmin(appId) {
      return hasRole(appId, 'admin');
    }

    function isWarehouse(appId) {
      return hasRole(appId, 'warehouse');
    }

    function isSales(appId) {
      return hasRole(appId, 'sales');
    }

    match /artifacts/{appId}/public/data/user_roles/{email} {
      allow get: if signedIn()
        && (request.auth.token.email == email || isAdmin(appId));
      allow list: if isAdmin(appId);
      allow create, update, delete: if isAdmin(appId)
        && email != request.auth.token.email;
    }

    match /artifacts/{appId}/public/data/account_directory/{email} {
      allow get: if signedIn()
        && (request.auth.token.email == email || isAdmin(appId));
      allow list: if isAdmin(appId);
      allow create: if isAdmin(appId)
        || (signedIn()
          && request.auth.token.email == email
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authActive == true
          && request.resource.data.keys()
            .hasOnly(['email', 'uid', 'displayName', 'authActive', 'lastSeenAt']));
      allow update: if isAdmin(appId)
        || (signedIn()
          && request.auth.token.email == email
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authActive == true
          && ((resource.data.uid == request.auth.uid
              && resource.data.authActive != false
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['displayName', 'authActive', 'lastSeenAt']))
            || (resource.data.authActive == false
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['uid', 'displayName', 'authActive', 'lastSeenAt']))));
      allow delete: if isAdmin(appId);
    }

    match /artifacts/{appId}/public/data/inventory/{itemId} {
      allow read: if hasActiveRole(appId);
      allow create, delete: if isAdmin(appId);
      allow update: if isAdmin(appId)
        || (isWarehouse(appId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity', 'reservedQuantity', 'lastUpdated', 'lastEditor'])
          && request.resource.data.quantity >= 0
          && request.resource.data.reservedQuantity >= 0
          && (request.resource.data.reservedQuantity <= request.resource.data.quantity
            || (request.resource.data.quantity == resource.data.quantity
              && request.resource.data.reservedQuantity <= resource.data.reservedQuantity)))
        || (isSales(appId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reservedQuantity', 'lastUpdated', 'lastEditor'])
          && request.resource.data.reservedQuantity >= 0
          && request.resource.data.reservedQuantity <= request.resource.data.quantity);
    }

    match /artifacts/{appId}/public/data/inventory_reservations/{requestId} {
      allow read: if hasActiveRole(appId);
      allow create: if hasActiveRole(appId)
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.requestedByEmail == request.auth.token.email;
      allow update: if resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'handledAt', 'handledByEmail'])
        && request.resource.data.handledByEmail == request.auth.token.email
        && ((isSales(appId)
            && resource.data.requestedByUid == request.auth.uid
            && request.resource.data.status == 'cancelled')
          || ((isWarehouse(appId) || isAdmin(appId))
            && request.resource.data.status in ['confirmed', 'returned', 'cancelled']));
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/settings/{settingId} {
      allow read: if hasActiveRole(appId);
      allow write: if isAdmin(appId);
    }

    match /artifacts/{appId}/public/data/audit_logs/{logId} {
      allow read: if hasActiveRole(appId);
      allow create: if hasActiveRole(appId)
        && request.resource.data.user == request.auth.token.email;
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/presence/{uid} {
      allow read: if hasActiveRole(appId);
      allow create, update: if hasActiveRole(appId)
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if hasActiveRole(appId) && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

